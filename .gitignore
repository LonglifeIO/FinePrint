# Android
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/captures/
*.jks
*.keystore
*.apk
*.aab

# Python / pipeline
.venv/
__pycache__/
*.pyc
# fetched policies, Play listings — copyrighted, never commit
pipeline/raw/
# LLM drafts awaiting review — never commit
pipeline/drafts/
# notes compiled from saved videos — a symlink into the owner's library, never commit
# (no trailing slash: "ingest/" would not match a symlink)
/ingest

# Databases, anywhere: none in the repo, and none on the device (no Room, no SQLite)
*.db
*.sqlite
*.sqlite3

# Secrets / tooling
.env
.codex/
.claude/settings.local.json
.DS_Store
