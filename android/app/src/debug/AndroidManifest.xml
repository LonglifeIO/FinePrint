<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: Android 17 blocks connections to local-network addresses (the emulator host 10.0.2.2,
     a LAN or Tailscale bundle server) unless the app holds this runtime permission. Grant it with
     adb shell pm grant com.longlifeio.fineprint android.permission.ACCESS_LOCAL_NETWORK
     Release builds fetch the bundle over the public internet and never declare it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Debug only (G5 step 1): renders design mockups from this phone's real data; started with adb. -->
    <application>
        <activity android:name="com.longlifeio.fineprint.design.MockupActivity" android:exported="true" />
    </application>
</manifest>
